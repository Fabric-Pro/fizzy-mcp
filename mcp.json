{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fizzy": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "fizzy-mcp"
      ],
      "env": {
        "FIZZY_ACCESS_TOKEN": "${FIZZY_ACCESS_TOKEN}"
      }
    }
  }
}
